# Database (Neon or Vercel Postgres) — see docs/ARCHITECTURE.md
DATABASE_URL=
DIRECT_URL=

# File storage
BLOB_READ_WRITE_TOKEN=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Transactional email — production. EMAIL_FROM's domain must be verified in
# Resend (liveosoft.com is verified as of 2026-08-28) — an unverified domain
# silently restricts delivery to the Resend account's own address only.
RESEND_API_KEY=
EMAIL_FROM="Home Inventory <noreply@liveosoft.com>"

# Transactional email — local development (see docs/ARCHITECTURE.md's
# "Local development — email testing"); leave EMAIL_PROVIDER unset to
# default to mailtrap outside production.
EMAIL_PROVIDER=mailtrap
MAILTRAP_HOST=
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# Rate limiting — omit in local dev to run unthrottled
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Expiry notification cron — see docs/ARCHITECTURE.md's "Expiration
# notification" section. Vercel sends this as a Bearer token automatically
# on cron-triggered requests once it's set as an env var.
CRON_SECRET=

# Web Push (browser push notifications) — generate with
# `npx web-push generate-vapid-keys`. VAPID_SUBJECT is a mailto: or https:
# contact identity sent to the browser vendor's push service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:skjamil2@gmail.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
