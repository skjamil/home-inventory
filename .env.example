# Database (Neon or Vercel Postgres) — see docs/ARCHITECTURE.md
DATABASE_URL=
DIRECT_URL=

# File storage
BLOB_READ_WRITE_TOKEN=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Transactional email — production
RESEND_API_KEY=
EMAIL_FROM="Home Inventory <onboarding@resend.dev>"

# Transactional email — local development (see docs/ARCHITECTURE.md's
# "Local development — email testing"); leave EMAIL_PROVIDER unset to
# default to mailtrap outside production.
EMAIL_PROVIDER=mailtrap
MAILTRAP_HOST=
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# Rate limiting — omit in local dev to run unthrottled
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
